{
  "compilerOptions": {
    "baseUrl": "src",
    "jsx": "preserve",
    "target": "ES2022",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "incremental": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsxImportSource": "react",
    "allowSyntheticDefaultImports": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "components/*": ["components/*"],
      "constants/*": ["constants/*"],
      "theme/*": ["theme/*"],
      "assets/*": ["assets/*"],
      "hooks/*": ["hooks/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
